generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Currency {
  USDT
  USDC
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  COMPLETED
}

enum ConversionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TenantStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
}

model Tenant {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  name                    String?
  email                   String   @unique
  password                String
  doc_type                String?
  doc_number              String   @unique
  address                 String?
  city                    String?
  state                   String?
  zip_code                String?
  country                 String?
  phone                   String?
  website                 String?
  webhook_url             String?
  logo_url                String?
  profilePhotoUrl         String?
  documentUrl             String?
  status                  TenantStatus @default(PENDING)
  
  // Preferences
  language                String   @default("pt-BR") // pt-BR, en-US, es-ES, fr-FR
  theme                   String   @default("system") // light, dark, system
  fiatCurrency            String   @default("BRL") // Display currency (BRL, USD, EUR)
  default_currency        Currency? @default(USDT)
  preference_locked_until DateTime?
  
  tokenVersion            Int      @default(1)
  twoFactorSecret         String?
  twoFactorEnabled        Boolean  @default(false)
  twoFactorBackupCodes    String[]
  isAdmin                 Boolean  @default(false)
  blockedAt               DateTime?
  blockedReason           String?
  documentRequested       Boolean  @default(false)
  documentRequestMsg      String?
  lastTermsAcceptedAt     DateTime?
  created_at              DateTime @default(now())

  wallets Wallet[]
  orders  Order[]
  saved_wallets SavedWallet[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Wallet {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenant_id  String   @db.ObjectId
  currency   Currency
  balance    Float
  updated_at DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  wallet_id  String            @db.ObjectId
  type       TransactionType
  amount     Float
  fee        Float
  tx_hash    String?
  description String?
  status     TransactionStatus
  created_at DateTime          @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [id])

  @@map("transactions")
}

model Order {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  tenant_id         String      @db.ObjectId
  fiat_amount       Float
  crypto_amount_est Float
  status            OrderStatus
  conversion_status ConversionStatus @default(PENDING)
  pix_code          String
  txid              String?     @unique
  payerName         String?
  payerDocument     String?
  created_at        DateTime    @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("orders")
}

model SavedWallet {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenant_id  String   @db.ObjectId
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  address    String
  network    String
  nickname   String?
  created_at DateTime @default(now())

  @@map("saved_wallets")
}

model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_codes")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String   @db.ObjectId
  action    String
  targetId  String?  @db.ObjectId
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  admin     Tenant   @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model LegalDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  type         String   // "terms" | "privacy"
  content_pt   String
  content_en   String
  content_es   String
  content_fr   String
  savedAt      DateTime @default(now())
  effectiveAt  DateTime
  createdById  String   @db.ObjectId

  @@map("legal_documents")
}

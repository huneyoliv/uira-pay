BINANCE_SECRET_KEY=""
BINANCE_TESTNET=false
BINANCE_PAY_MERCHANT_ID=""        # Optional: Binance Pay Merchant ID (for auto-replenishment — apply at merchant.binance.com)

# Security
ADMIN_SECRET_KEY=""
JWT_SECRET=""                   # Required — app will not start without this

# Server
PORT=8080
DOMAIN=""
FRONTEND_URL=""                 # Required for CORS — e.g. https://swaptune.me

# Email

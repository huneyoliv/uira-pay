DATABASE_URL=""

# Efí (PIX Gateway)
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
EFI_CERTIFICATE_BASE64=""       # Preferred: base64-encoded .p12 certificate (for secret managers)
# EFI_CERTIFICATE_PATH=""       # Deprecated: use EFI_CERTIFICATE_BASE64 instead
EFI_SANDBOX=false
EFI_PIX_KEY=""
EFI_WEBHOOK_SECRET=""           # HMAC signature secret for webhook validation
EFI_WEBHOOK_URL_SECRET=""       # URL token for webhook authentication fallback

# Binance
